+def count_valid_colorings(n: int, m: int) -> int:
+    MOD = 998244353
+    
+    if n == 1:
+        return m % MOD
+    
+    # Create the transition matrix for the linear case
+    transition = [[0] * m for _ in range(m)]
+    for i in range(m):
+        for j in range(m):
+            if i != j:
+                transition[i][j] = 1
+    
+    # Function to multiply two matrices under modulo
+    def matrix_multiply(A, B):
+        result = [[0] * m for _ in range(m)]
+        for i in range(m):
+            for j in range(m):
+                for k in range(m):
+                    result[i][j] = (result[i][j] + A[i][k] * B[k][j]) % MOD
+        return result
+    
+    # Function to exponentiate a matrix under modulo
+    def matrix_power(matrix, exp):
+        result = [[1 if i == j else 0 for j in range(m)] for i in range(m)]
+        base = matrix
+        while exp > 0:
+            if exp % 2 == 1:
+                result = matrix_multiply(result, base)
+            base = matrix_multiply(base, base)
+            exp //= 2
+        return result
+    
+    # Compute the (n-1)th power of the transition matrix
+    transition_power = matrix_power(transition, n - 1)
+    
+    # The number of valid colorings for n people is the sum of the first row of the matrix
+    total_ways = sum(transition_power[0]) % MOD
+    
+    return total_ways
+
+# Use check(count_valid_colorings) to run tests.
