+def count_valid_colorings(n: int, m: int) -> int:
+    MOD = 998244353
+    
+    if n == 1:
+        return m % MOD
+    
+    # dp[i][j] will store the number of ways to color the first i people
+    # such that the i-th person has color j
+    dp = [[0] * m for _ in range(n)]
+    
+    # Base case: for the first person, we can choose any of the m colors
+    for j in range(m):
+        dp[0][j] = 1
+    
+    # Fill the dp table for the first n-1 people
+    for i in range(1, n-1):
+        for j in range(m):
+            dp[i][j] = sum(dp[i-1][k] for k in range(m) if k != j) % MOD
+    
+    # Now, we need to handle the circular nature of the problem
+    # We need to count the valid ways to color the last person such that
+    # it is different from the first person
+    total_ways = 0
+    for j in range(m):
+        total_ways += sum(dp[n-2][k] for k in range(m) if k != j) % MOD
+        total_ways %= MOD
+    
+    return total_ways
+
