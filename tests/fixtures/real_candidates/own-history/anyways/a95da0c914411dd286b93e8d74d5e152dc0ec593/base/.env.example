# Search discovery is optional. Missing API keys never stop the local pipeline.
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Free-tier guardrails. Do not enable provider auto-recharge or paid overages.
RESEARCH_PAID_USAGE_ALLOWED=false
RESEARCH_MAX_SEARCH_REQUESTS_PER_ARTICLE=40
RESEARCH_MAX_SEARCH_REQUESTS_PER_QUERY=3
RESEARCH_MAX_SOURCE_PAGES_PER_ARTICLE=25
RESEARCH_MAX_RESULTS_PER_SEARCH=10
RESEARCH_SEARCH_TIMEOUT_MS=15000
RESEARCH_MINIMUM_PRIMARY_SOURCES=2
RESEARCH_MINIMUM_INDEPENDENT_SOURCES=3
RESEARCH_MINIMUM_USEFUL_RESULTS_BEFORE_ESCALATION=4
RESEARCH_CACHE_SEARCH_RESULTS=true
RESEARCH_CACHE_FETCHED_PAGES=true
RESEARCH_BROWSER_SEARCH_ENABLED=true

# The article writer is one non-interactive Codex/SOL call that returns Markdown.
# Point this to the authenticated Codex CLI when a launch agent has a limited PATH.
ANYWAYS_CODEX_BIN=codex
ANYWAYS_WRITER_MODEL=gpt-5.6-sol
ANYWAYS_WRITER_REASONING_EFFORT=medium
ANYWAYS_WRITER_TIMEOUT_MS=600000
