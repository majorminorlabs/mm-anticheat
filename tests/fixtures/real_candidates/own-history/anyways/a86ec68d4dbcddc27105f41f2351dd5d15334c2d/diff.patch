1\" stroke=\"white\"/><rect x=\"4\" y=\"7.6001\" width=\"8\" height=\"0.8\" fill=\"white\"/><rect class=\"hds-mobile-submenu-toggle-icon-line-vertical\" x=\"7.59998\" y=\"12\" width=\"8\" height=\"0.8\" transform=\"rotate(-90 7.59998 12)\" fill=\"white\"/></svg></button>\n<ul id=\"basic-nav-section-one\" class=\"usa-nav__submenu\" hidden>\n<li class=\"usa-nav__submenu-item \"><a class=\"usa-nav__link\" target=\"_self\" href=\"https://science.nasa.gov/earth/earth-observatory/about-the-eo/\" rel=\"noopener\">About Us</a></li>\n<li class=\"usa-nav__submenu-item \"><a class=\"usa-nav__link\" target=\"_self\" href=\"https://science.nasa.gov/earth/earth-observatory/subscribe\" rel=\"noopener\">Subscribe</a></li>\n<li class=\"usa-nav__submenu-item \"><a class=\"usa-nav__link\" target=\"_self\" href=\"https://science.nasa.gov/earth/earth-observatory/subscribe/feeds/\" rel=\"noopener\">ğŸ›œ RSS</a></li>\n<li class=\"usa-nav__submenu-item \"><a class=\"usa-nav__link\" target=\"_self\" href=\"https://science.nasa.gov/earth/earth-observatory/contact-the-eo/\" rel=\"noopener\">Contact Us</a></li>\n</ul>\n</li>\n<li class=\"usa-nav__primary-item \"><a class=\"usa-nav__link\" href=\"https://science.nasa.gov/earth/earth-observatory/search/\" rel=\"noopener\">Search</a></li>\n</ul>\n</nav>\n</div>\n<div class=\"hds-secondary-navigation-menu-spacer\">Â </div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"\" class=\"hds-media hds-module wp-block-image\">\n<div class=\"margin-left-auto margin-right-auto nasa-block-align-inline\">\n<div class=\"hds-media-wrapper margin-left-auto margin-right-auto\">\n<figure class=\"hds-media-inner hds-cover-wrapper hds-media-ratio-none \"><a href=\"https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=2160&#038;h=1740&#038;fit=clip&#038;crop=faces%2Cfocalpoint\" rel=\"noopener\"><img fetchpriority=\"high\" decoding=\"async\" width=\"2160\" height=\"1740\" src=\"https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=2160&#038;h=1740&#038;fit=clip&#038;crop=faces%2Cfocalpoint\" class=\"attachment-2048x2048 size-2048x2048\" alt=\"Long plumes of gray wildfire smoke stream northeast from a line of fires in central and eastern Oregon, including the Beachcomb, Shingle, and Second Flat fires that threatened communities.\" style=\"transform: scale(1); transform-origin: 50% 50%; object-position: 50% 50%; object-fit: cover;\" block_context=\"nasa-block\" loading=\"eager\" srcset=\"https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=2160&#038;h=1740&#038;fit=crop&#038;crop=faces%2Cfocalpoint 2160w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=300&#038;h=242&#038;fit=crop&#038;crop=faces%2Cfocalpoint 300w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=768&#038;h=619&#038;fit=crop&#038;crop=faces%2Cfocalpoint 768w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=1024&#038;h=825&#038;fit=crop&#038;crop=faces%2Cfocalpoint 1024w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=1536&#038;h=1237&#038;fit=crop&#038;crop=faces%2Cfocalpoint 1536w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=2048&#038;h=1650&#038;fit=crop&#038;crop=faces%2Cfocalpoint 2048w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=400&#038;h=322&#038;fit=crop&#038;crop=faces%2Cfocalpoint 400w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=600&#038;h=483&#038;fit=crop&#038;crop=faces%2Cfocalpoint 600w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=900&#038;h=725&#038;fit=crop&#038;crop=faces%2Cfocalpoint 900w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=1200&#038;h=967&#038;fit=crop&#038;crop=faces%2Cfocalpoint 1200w, https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726.jpg?w=2000&#038;h=1611&#038;fit=crop&#038;crop=faces%2Cfocalpoint 2000w\" sizes=\"auto, (max-width: 2160px) 100vw, 2160px\" /></a></figure><figcaption class=\"hds-caption padding-y-2\">\n<div class=\"hds-caption-text p-sm margin-0\">Smoke pours from dozens of large fires in Oregon in this image captured by <a href=\"https://modis.gsfc.nasa.gov/about/\" target=\"_blank\" rel=\"noopener\">MODIS</a> (Moderate Resolution Imaging Spectroradiometer) on NASAâ€™s <a href=\"https://aqua.nasa.gov/\" target=\"_blank\" rel=\"noopener\">Aqua</a> satellite on July 26, 2026.</div>\n<div class=\"hds-credits\">NASA Earth Observatory/Michala Garrison</div>\n</figcaption></div>\n</div>\n</div>\n<p class=\"wp-block-paragraph\">Dry thunderstorms that popped up over the <a href=\"https://science.nasa.gov/earth/earth-observatory/panorama-of-the-pacific-northwest-86041/\" rel=\"noopener\">Cascade Range</a> on the evening of July 15, 2026, peppered Oregon and Washington with thousands of <a href=\"https://www.sfchronicle.com/california-wildfires/article/oregon-washington-lightning-fires-22349526.php\" rel=\"noopener\">lightning strikes</a> as they moved east across the states. By the following day, NASA satellites had <a href=\"https://worldview.earthdata.nasa.gov/?v=-124.07156198059945,41.303712125281805,-117.54884840768591,46.87119294791597&#038;l=Reference_Labels_15m,Reference_Features_15m,Coastlines_15m,HLS_L30_Nadir_BRDF_Adjusted_Reflectance(hidden),MODIS_Combined_Thermal_Anomalies_All,VIIRS_SNPP_Thermal_Anomalies_375m_All,VIIRS_NOAA20_Thermal_Anomalies_375m_All,VIIRS_NOAA21_Thermal_Anomalies_375m_All,OCI_PACE_True_Color(hidden),VIIRS_NOAA21_CorrectedReflectance_TrueColor(hidden),VIIRS_NOAA20_CorrectedReflectance_TrueColor(hidden),VIIRS_SNPP_CorrectedReflectance_TrueColor(hidden),MODIS_Aqua_CorrectedReflectance_TrueColor,MODIS_Terra_CorrectedReflectance_TrueColor(hidden)&#038;lg=true&#038;t=2026-07-16-T15%3A19%3A55Z\" rel=\"noopener\">begun to detect</a> large numbers of wildland fires burning throughout central and eastern Oregon.</p>\n<p class=\"wp-block-paragraph\">Though initially small, these blazes strengthened as they were fanned by gusty winds and raced through landscapes parched by <a href=\"https://droughtmonitor.unl.edu/CurrentMap/StateDroughtMonitor.aspx?OR\" rel=\"noopener\">extreme drought</a> and baking in summer heat. When NASAâ€™s <a href=\"https://aqua.nasa.gov/\" rel=\"noopener\">Aqua</a> satellite captured the image shown above on the afternoon of July 26, smoke poured northeast from dozens of large fires that had collectively charred hundreds of square miles. The fires produced a blanket of haze, prompting state officials to issue <a href=\"https://www.oregonsmoke.org/2026/07/air-quality-advisory-for-eastern-oregon.html\" rel=\"noopener\">air quality advisories</a> for eastern Oregon.</p>\n<p class=\"wp-block-paragraph\">Many communities faced evacuation orders as more than 10,000 firefighters battled wildfires throughout the state. On the day the image was captured, the largest active fires were the Hay Creek Complex, Brewer, Big Grass, Akawa Butte, and Powder River fires. Several of these blazes were less than 5 percent contained, according to the <a href=\"https://www.nifc.gov/fire-information/nfn#Oregon\" rel=\"noopener\">National Interagency Fire Center</a>. State officials invoked Oregonâ€™s Emergency Conflagration Act to protect communities as they responded to particularly threatening fires such as the <a href=\"https://apps.oregon.gov/oregon-newsroom/OR/OSFM/Posts/Post/bench-beachcomb-secondflat-conflagration\" rel=\"noopener\">Shingle, Bench, Beachcomb, and Second Flat</a> fires.</p>\n<p class=\"wp-block-paragraph\">Government satellite data are part of a global system of observations used to track fire behavior and analyze emerging trends. Among the real-time wildfire monitoring tools that NASA makes available are <a href=\"https://firms.modaps.eosdis.nasa.gov/map/#d:2026-07-21..2026-07-27;@-119.6,44.3,7.7z\" rel=\"noopener\">FIRMS</a> (Fire Information for Resource Management System), the <a href=\"https://go.nasa.gov/3TXMT6Z\" data-type=\"link\" data-id=\"https://go.nasa.gov/3TXMT6Z\" rel=\"noopener\">Worldview</a> browser, and the<a href=\"https://earthdata.nasa.gov/dashboard/tools/fire-event-explorer?fireEventExplorer=%7B%22selectedEventId%22%3Anull%2C%22windLayerType%22%3Anull%2C%22show3DMap%22%3Afalse%2C%22showPerimeterNrt%22%3Atrue%2C%22showFireline%22%3Afalse%2C%22showNewFirepix%22%3Afalse%2C%22viewMode%22%3A%22explorer%22%2C%22timeRange%22%3A%7B%22start%22%3A%222026-06-28T03%3A59%3A59.999Z%22%2C%22end%22%3A%222026-07-28T03%3A59%3A59.999Z%22%7D%2C%22selectedDuration%22%3A%7B%22label%22%3A%221+month%22%2C%22value%22%3A2592000000%7D%2C%22viewStateForUrl%22%3A%7B%22longitude%22%3A-119.46505482280062%2C%22latitude%22%3A44.42149597461622%2C%22zoom%22%3A5.988867522623744%2C%22pitch%22%3A0%2C%22bearing%22%3A0%2C%22padding%22%3A%7B%22top%22%3A40%2C%22bottom%22%3A40%2C%22left%22%3A40%2C%22right%22%3A40%7D%2C%22minZoom%22%3A2%2C%22maxZoom%22%3A10%7D%2C%22viewState%22%3A%7B%22longitude%22%3A-119.46505482280062%2C%22latitude%22%3A44.42149597461622%2C%22zoom%22%3A5.988867522623744%2C%22pitch%22%3A0%2C%22bearing%22%3A0%2C%22padding%22%3A%7B%22top%22%3A40%2C%22bottom%22%3A40%2C%22left%22%3A40%2C%22right%22%3A40%7D%7D%7D\" data-type=\"link\" data-id=\"https://earthdata.nasa.gov/dashboard/tools/fire-event-explorer?fireEventExplorer=%7B%22selectedEventId%22%3Anull%2C%22windLayerType%22%3Anull%2C%22show3DMap%22%3Afalse%2C%22showPerimeterNrt%22%3Atrue%2C%22showFireline%22%3Afalse%2C%22showNewFirepix%22%3Afalse%2C%22viewMode%22%3A%22explorer%22%2C%22timeRange%22%3A%7B%22start%22%3A%222026-06-28T03%3A59%3A59.999Z%22%2C%22end%22%3A%222026-07-28T03%3A59%3A59.999Z%22%7D%2C%22selectedDuration%22%3A%7B%22label%22%3A%221+month%22%2C%22value%22%3A2592000000%7D%2C%22viewStateForUrl%22%3A%7B%22longitude%22%3A-119.46505482280062%2C%22latitude%22%3A44.42149597461622%2C%22zoom%22%3A5.988867522623744%2C%22pitch%22%3A0%2C%22bearing%22%3A0%2C%22padding%22%3A%7B%22top%22%3A40%2C%22bottom%22%3A40%2C%22left%22%3A40%2C%22right%22%3A40%7D%2C%22minZoom%22%3A2%2C%22maxZoom%22%3A10%7D%2C%22viewState%22%3A%7B%22longitude%22%3A-119.46505482280062%2C%22latitude%22%3A44.42149597461622%2C%22zoom%22%3A5.988867522623744%2C%22pitch%22%3A0%2C%22bearing%22%3A0%2C%22padding%22%3A%7B%22top%22%3A40%2C%22bottom%22%3A40%2C%22left%22%3A40%2C%22right%22%3A40%7D%7D%7D\" rel=\"noopener\"> Fire Event Explorer</a>.</p>\n<p class=\"wp-block-paragraph\">As of July 27, 2026, fires in Oregon had burned more than one million acres, according to <a href=\"https://www.kgw.com/article/news/local/wildfire/latest-updates-oregon-wildfires-hay-creek-rowe-creek-total-acres-burned/283-36c62da7-82e7-4f7d-b571-7204d55c9f41\" rel=\"noopener\">news outlets</a>. Meanwhile, the <a href=\"https://www.nifc.gov/fire-information/nfn\" rel=\"noopener\">National Interagency Fire Center</a> reported that fires had burned more than 4 million acres across the United States.Â The 10-year average (2016-2025) for this point in the season is 3.4 million acres.</p>\n<div style=\"height:30px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<p class=\"wp-block-paragraph\"><em>NASA Earth Observatory image by Michala Garrison, using MODIS data from NASAÂ </em><a href=\"https://www.earthdata.nasa.gov/data/projects/lance\" rel=\"noopener\"><em>EOSDIS LANCE</em></a><em>Â andÂ </em><a href=\"https://worldview.earthdata.nasa.gov/\" rel=\"noopener\"><em>GIBS/Worldview</em></a><em>.</em> <em>Story by Adam Voiland.</em></p>\n<div id=\"\" class=\"hds-featured-file-list bg-spacesuit-white padding-x-2 tablet:padding-x-3 desktop:padding-x-4 padding-y-5 desktop:padding-y-6 hds-module align wp-block-nasa-blocks-file-list\">\n<div class=\"grid-container grid-container-block padding-0\">\n<div class=\"grid-row width-full margin-bottom-4\">\n<div class=\"grid-col-12 desktop:grid-col-6 margin-bottom-2 desktop:margin-bottom-0\">\n<h2 class=\"heading-22\">\n\t\t\t\t\tDownloads\t\t\t\t</h2>\n</p></div>\n<div class=\"grid-col-12 desktop:grid-col-6\">\n<div class=\"desktop:grid-col display-flex flex-align-center desktop:flex-justify-end\">\n\t\t\t\t\t\t\t\t\t</div>\n</p></div>\n</p></div>\n<div class=\"hds-list-row hds-file-list-row\">\n<div class=\"hds-list-thumbnail hds-file-list-thumbnail\">\n<div class=\"hds-list-thumbnail-inner hds-file-list-thumbnail-inner hds-cover-wrapper\">\n<figure class=\"hds-media-background  \"><img decoding=\"async\" width=\"2160\" height=\"1740\" src=\"https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2026/smoke-blankets-oregon/oregonfires_amo_20260726_lrg.jpg?w=2160&#038;h=1740&#038;fit=clip&#038;crop=faces%2Cfocalpoint\" class=\"attachment-thumbnail size-thumbnail\" alt=\"Long plumes of gray wildfire smoke stream northeast from a line of fires in central and eastern Oregon, including the Beachcomb, Shingle, and Second Flat fires that threatened communities.\" style=\"transform: scale(1.2); transform-origin: 50% 50%; object-position: 50% 50%; object-fit: cover;\" block_context=\"nasa-block\" loading=\"lazy\" data-video-loop=\"\" srcset=\"https://assets.science.nasa.gov/dynamicimage/assets/science/esd/eo/images/iotd/2