SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANYWAYS_REPO_PATH=/Volumes/External/GitHub/IGNORED/anyways
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b-a3b-nvfp4
# Absolute executable used for Codex version checks and provider subprocesses.
ANYWAYS_CODEX_BIN=/absolute/path/to/codex
PIPELINE_V1_ENABLED=false
# When the global flag is false, only this exact controller job ID may use V1.
PIPELINE_V1_ALLOWED_JOB_ID=
CONTROLLER_ID=
POLL_INTERVAL_SECONDS=5
LEASE_DURATION_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=30
MODEL_IDLE_TIMEOUT_MINUTES=2
MINIMUM_AVAILABLE_MEMORY_GB=3
MAX_PARALLEL_HEAVY_JOBS=1
HEALTH_HOST=127.0.0.1
HEALTH_PORT=4317
LOG_DIRECTORY=
JOB_TIMEOUT_SECONDS=900
PHASE2_JOB_TIMEOUT_SECONDS=2400
CHILD_KILL_GRACE_SECONDS=5
MAX_ATTEMPTS=3
BASE_RETRY_DELAY_SECONDS=60
# X Browser: Chrome creates and owns this normal dedicated profile. Never put
# cookies, tokens, passwords, or other session data in this file.
X_BROWSER_SESSION_MODE=cdp
X_BROWSER_CDP_URL=http://127.0.0.1:9222
X_BROWSER_USER_DATA_DIR=/Users/your-user/Library/Application Support/Anyways X Chrome
X_BROWSER_PROFILE_NAME=Anyways X
X_BROWSER_PROFILE_DIRECTORY=Default
# X_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# X_BROWSER_HEADLESS=true
# X_BROWSER_TIMEOUT_MS=12000
