{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyways",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "anyways.media", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnywaysContainer"] },
    { "tag": "v2-remove-container", "deleted_classes": ["AnywaysContainer"] }
  ]
}
