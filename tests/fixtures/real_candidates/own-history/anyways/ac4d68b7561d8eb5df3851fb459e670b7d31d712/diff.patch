@@ -1,3 +1,5 @@
+/* Anyways · shared base + newsroom desk. Public edition styles live in public.css. */
+
 /* ==========================================================================
    Anyways · The Composed Edition
    Foundation: paper, ink, rules, punctuation.
@@ -159,734 +161,6 @@ p { margin: 0; }
   padding: 0 var(--gutter);
 }
 
-/* ---------- Signature objects ------------------------------------------ */
-
-/* The edition chip: № on the story's accent. */
-.chip {
-  display: inline-block;
-  font-family: var(--mono);
-  font-size: var(--label);
-  font-weight: 500;
-  letter-spacing: var(--tracking-label);
-  background: var(--acc);
-  color: var(--on-acc);
-  padding: 0.22em 0.6em 0.18em;
-  white-space: nowrap;
-}
-
-/* The tick: a small accent square that marks a composed thing. */
-.tick {
-  display: inline-block;
-  width: 0.62em;
-  height: 0.62em;
-  background: var(--acc);
-  flex: none;
-}
-
-/* The riso highlight: section links inside a story's scope. */
-.hilite {
-  background: linear-gradient(to top, color-mix(in srgb, var(--acc) 42%, transparent) 40%, transparent 40%);
-  padding: 0 0.12em;
-  transition: background-size 0.2s ease;
-}
-.hilite:hover { background: linear-gradient(to top, color-mix(in srgb, var(--acc) 70%, transparent) 88%, transparent 88%); }
-
-/* ---------- Plates: photography as a compositional material -------------
-   A plate is an image plus its caption. Treatments are reusable: an offset
-   frame, an arch, a circle, a fade into the paper, a duotone tint. */
-
-.plate { position: relative; isolation: isolate; margin: 0; }
-.plate img { width: 100%; position: relative; z-index: 1; }
-.plate figcaption {
-  display: flex;
-  justify-content: space-between;
-  gap: 1em;
-  margin-top: 0.55em;
-  font-family: var(--mono);
-  font-size: var(--meta);
-  letter-spacing: 0.02em;
-  color: var(--ink-faint);
-}
-
-/* Offset frame: the image sits on a shifted block of the story accent. */
-.plate--frame { padding: 0; }
-.plate--frame::before {
-  content: "";
-  position: absolute;
-  inset: 0.8rem -0.8rem -0.8rem 0.8rem;
-  background: var(--acc);
-  z-index: 0;
-}
-.plate--frame figcaption { padding-right: 0.8rem; }
-
-/* Arch: a portrait crop with a rounded top, like a window. */
-.plate--arch img { aspect-ratio: 4 / 5; object-fit: cover; border-radius: 999px 999px 0 0; }
-
-/* Circle: a small round inset. */
-.plate--circle img { aspect-ratio: 1; object-fit: cover; border-radius: 50%; }
-
-/* Fade: the bottom edge dissolves into the paper. */
-.plate--fade img {
-  -webkit-mask-image: linear-gradient(#000 58%, transparent 96%);
-  mask-image: linear-gradient(#000 58%, transparent 96%);
-}
-
-/* Duotone: grayscale plate washed with the accent, like a riso pass. */
-.plate--duo img { filter: grayscale(1) contrast(1.06); }
-.plate--duo::after {
-  content: "";
-  position: absolute;
-  inset: 0;
-  background: var(--acc);
-  mix-blend-mode: multiply;
-  opacity: 0.32;
-  z-index: 2;
-  pointer-events: none;
-}
-
-/* Letterbox: a wide cinematic strip. */
-.plate--letterbox img { aspect-ratio: 21 / 9; object-fit: cover; }
-
-/* Float plates wrap the text around them and lean into the margin. */
-.plate--float { float: right; width: min(46%, 17rem); margin: 0.35em 0 1.3em 1.7em; }
-.plate--left { float: left; width: min(46%, 17rem); margin: 0.35em 1.7em 1.3em 0; }
-
-/* Centered medium plate. */
-.plate--center { max-width: 30rem; margin: 2.2em auto; }
-
-/* ---------- Margin notes: persistent editorial annotation ----------------
-   Floated out of the article flow into the right margin on wide screens.
-   In flow, with an accent top rule, on narrow ones. */
-
-.mn {
-  float: right;
-  clear: right;
-  width: 11.5rem;
-  margin: 0.3em 0 1.5em 2em;
-  border-top: 2px solid var(--acc);
-  padding-top: 0.55em;
-}
-.mn .mn-label {
-  display: block;
-  font-family: var(--mono);
-  font-size: var(--micro);
-  font-weight: 500;
-  letter-spacing: var(--tracking-micro);
-  text-transform: uppercase;
-  color: var(--ink-soft);
-  margin-bottom: 0.5em;
-}
-.mn p { font-size: 0.95rem; line-height: 1.5; font-style: italic; color: var(--ink-soft); margin: 0 0 0.5em; }
-.mn a { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
-.mn a:hover { color: var(--acc); }
-.mn .mn-no { font-family: var(--mono); font-size: var(--label); color: var(--acc); font-style: normal; font-weight: 500; }
-
-/* ---------- The interruption ---------------------------------------------
-   One per story, guaranteed. A solid accent band carrying the story's brief,
-   set big, breaking the measure on both sides. */
-
-.interruption {
-  position: relative;
-  background: var(--acc);
