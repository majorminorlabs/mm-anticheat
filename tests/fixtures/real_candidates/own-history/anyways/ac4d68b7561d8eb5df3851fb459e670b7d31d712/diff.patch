-/* ---------- Ambient press loops (story pages) -------------------------------
-   The homepage is a finished object; the article is a live press run. Three
-   small constant loops, each in its own labeled block:
-     1. Registration drift — the hero color plate breathes off-register.
-     2. The stamp re-inks — the hero № folio presses a hair deeper ~every 12s.
-     3. The reading strip — a registration hairline pinned to the viewport top
-        tracks scroll progress (scroll-driven where supported; ambient-fx.js
-        tracks scroll and drives --strip-x everywhere else).
-   Preview switches (public/ambient-fx.js sets classes on <html>): default on;
-   ?fx=off disables all three; ?fx=no-drift,no-stamp,no-strip disables loops
-   individually. The newsroom preview iframe never loads the switch script, so
-   editors always see the still page. To drop one loop permanently, delete its
-   block; to drop the feature, delete this whole section plus
-   public/ambient-fx.js and its <script> tag in public/index.html.
-   Loops animate the composable translate/rotate properties, so they layer on
-   top of the paste-up transforms above instead of fighting them. */
-
-/* --- Ambient loop 1: registration drift ---------------------------------- */
-@keyframes reg-drift {
-  0%, 100% { translate: 0 0; rotate: 0deg; }
-  32% { translate: 0.09rem 0.05rem; rotate: 0.14deg; }
-  68% { translate: -0.07rem 0.1rem; rotate: -0.12deg; }
-}
-
-@supports (rotate: 0.1deg) {
-  html.fx-ambient:not(.fx-no-drift) .route-story .comp:not([data-article-preview]) .article-window .window-registration {
-    animation: paste-reg 0.6s cubic-bezier(0.25, 0.8, 0.3, 1) 0.15s both,
-      reg-drift 11s ease-in-out 1.4s infinite;
-  }
-}
-
-/* --- Ambient loop 2: the stamp re-inks --------------------------------------
-   One 12s loop with a ~0.5s press near the end of each cycle. */
-@keyframes stamp-reink {
-  0%, 92.5% { translate: 0 0; rotate: 0deg; }
-  94.5% { translate: 0.06rem 0.06rem; rotate: -0.35deg; }
-  96.5% { translate: 0 0; rotate: 0.12deg; }
-  100% { translate: 0 0; rotate: 0deg; }
-}
-
-@supports (rotate: 0.1deg) {
-  html.fx-ambient:not(.fx-no-stamp) .route-story .comp:not([data-article-preview]) .article-head .riso-folio--hero {
-    animation: stamp-slam 0.5s cubic-bezier(0.3, 0.9, 0.4, 1) 0.42s both,
-      stamp-reink 12s ease-in-out 1.6s infinite;
-  }
-}
-
-/* --- Ambient loop 3: the reading strip --------------------------------------
-   A hairline twin of the nameplate registration strip, pinned to the top of
-   the viewport; its inks slide with scroll position, one full rainbow over
-   the length of the story. The hairline exists in every browser; where
-   scroll-driven animations are supported it is pure CSS, and everywhere else
-   ambient-fx.js adds fx-strip-js and drives --strip-x from a scroll listener. */
-@keyframes strip-track {
-  from { background-position-x: 0%; }
-  to { background-position-x: 100%; }
-}
-
