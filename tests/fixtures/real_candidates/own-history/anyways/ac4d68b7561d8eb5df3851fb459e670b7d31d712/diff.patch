-/* ---------- Paste-up motion -------------------------------------------------
-   The edition assembles itself like a print-room paste-up: the registration
-   strip is inked, the color plate lands, the photo is pasted on top of it
-   (creating the misregistration live), the folio is stamped, and the
-   headline is laid onto the page. Each beat plays exactly once; below-fold
-   pieces assemble on scroll entry, then go still. Transform and opacity,
-   plus brief one-off paint effects on small elements. */
-
-@keyframes strip-ink {
-  from { transform: scaleX(0); }
-  to { transform: scaleX(1); }
-}
-
-.public-site .nameplate::after {
-  transform-origin: left center;
-  animation: strip-ink 0.55s cubic-bezier(0.2, 0.75, 0.2, 1) 0.05s both;
-}
-
-/* The choreography owns the story page; the generic rise steps aside. */
-.public-site.route-story main > .comp { animation: none; }
-
-/* The color plate lands exactly under the photo, then slips to its corner
-   as the photo is pasted down — the misregistration happens in front of you. */
-@keyframes paste-reg {
-  0% { opacity: 0; transform: translate(-0.9rem, -0.9rem); }
-  40% { opacity: 1; transform: translate(-0.9rem, -0.9rem); }
-  100% { opacity: 1; transform: none; }
-}
-
-@keyframes paste-photo {
-  from { opacity: 0; transform: translateY(-0.7rem) rotate(-0.5deg); }
-  to { opacity: 1; transform: none; }
-}
-
-@keyframes paste-develop {
-  from { filter: saturate(0) contrast(1.15); }
-  to { filter: saturate(0.92) contrast(1.08); }
-}
-
-/* The stamp slaps down over-rotated and settles; its ink shadow is cast on
-   impact rather than flying in with it. --stamp-ink lets contexts whose stamp
-   casts a different shadow (the homepage lead casts paper) reuse the beat. */
-@keyframes stamp-slam {
-  0% { opacity: 0; transform: rotate(-9deg) scale(1.25); box-shadow: 0 0 0 var(--stamp-ink, var(--ink)); }
-  52% { opacity: 1; transform: rotate(-0.4deg) scale(0.97); box-shadow: 0 0 0 var(--stamp-ink, var(--ink)); }
-  58% { box-shadow: 0.6rem 0.6rem 0 var(--stamp-ink, var(--ink)); }
-  76% { transform: rotate(-2.4deg) scale(1.015); }
-  100% { opacity: 1; transform: rotate(-1.5deg) scale(1); box-shadow: 0.6rem 0.6rem 0 var(--stamp-ink, var(--ink)); }
-}
-
-/* A paper-edge wipe passes over the headline while it settles into place. */
-@keyframes headline-lay {
-  from { opacity: 0; clip-path: inset(0 0 100% 0); transform: translateY(0.3em); }
-  30% { opacity: 1; }
-  to { opacity: 1; clip-path: inset(0 0 -0.25em 0); transform: none; }
-}
-
-@keyframes rise-in {
-  from { opacity: 0; transform: translateY(0.55rem); }
-  to { opacity: 1; transform: none; }
-}
-
-@keyframes rule-draw {
-  from { clip-path: inset(-0.5rem 100% -0.5rem 0); }
-  to { clip-path: inset(-0.5rem 0 -0.5rem 0); }
-}
-
-.route-story .comp:not([data-article-preview]) .article-window .window-registration {
-  animation: paste-reg 0.6s cubic-bezier(0.25, 0.8, 0.3, 1) 0.15s both;
-}
