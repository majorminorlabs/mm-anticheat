-  content: "";
-  position: fixed;
-  z-index: 4;
-  top: env(safe-area-inset-top, 0px);
-  right: 0;
-  left: 0;
-  height: 0.3rem;
-  pointer-events: none;
-  background: linear-gradient(
-    90deg,
-    #00c2df 0 8.333%,
-    #e8348a 8.333% 16.666%,
-    #d99b00 16.666% 25%,
-    #ffe500 25% 33.333%,
-    #b83b27 33.333% 41.666%,
-    #3155d9 41.666% 50%,
-    #ff5d4a 50% 58.333%,
-    #6fe1b1 58.333% 66.666%,
-    #b8e100 66.666% 75%,
-    #ffad7a 75% 83.333%,
-    #b9a0ff 83.333% 91.666%,
-    #087a58 91.666% 100%
-  );
-  background-size: 200% 100%;
-  background-position-x: var(--strip-x, 0%);
-  transform-origin: left center;
-  animation: strip-ink 0.55s cubic-bezier(0.2, 0.75, 0.2, 1) 0.05s both;
-}
-
-@supports (animation-timeline: scroll(root)) {
-  html.fx-ambient:not(.fx-no-strip):not(.fx-strip-js) .public-site::before {
-    animation: strip-ink 0.55s cubic-bezier(0.2, 0.75, 0.2, 1) 0.05s both,
-      strip-track linear both;
