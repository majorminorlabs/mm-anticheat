-  font-size: clamp(1.42rem, 2.9vw, 2.1rem);
-  line-height: 1.22;
-  letter-spacing: -0.012em;
-  font-style: italic;
-  font-weight: 500;
-  margin: 0.55em 0 0.7em;
-  max-width: 26ch;
-}
-.interruption .numeral { color: color-mix(in srgb, var(--on-acc) 78%, transparent); }
-
-/* ---------- Nameplate --------------------------------------------------- */
-
-.nameplate { border-top: 2px solid var(--ink); }
-
-.dateline {
-  display: flex;
-  justify-content: space-between;
