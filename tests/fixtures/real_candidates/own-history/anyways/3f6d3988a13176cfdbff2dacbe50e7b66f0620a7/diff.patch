diff --git a/src/app.mjs b/src/app.mjs
index eda9077..aff5ae8 100644
--- a/src/app.mjs
+++ b/src/app.mjs
@@ -1084,7 +1084,7 @@ function storyPrimaryAction({ status, story, job, candidate }) {
   if (status === 'draft') return href ? `<a class="button" href="${href}">Open draft</a>` : '<span class="field-note">Draft is being assembled</span>';
   if (status === 'needs_attention') return `${researchAction}${href ? ` <a class="button quiet" href="${href}#sources">Review claims</a>` : '<span class="field-note">Open the retained review package</span>'}`;
   if (status === 'ready') return href ? `<a class="button" href="${href}#publish">Publish</a>` : candidate?.id ? `<a class="button" href="/newsroom/stories?candidate=${encodeURIComponent(candidate.external_id || candidate.id)}#review-package">Review claims</a>` : '<span class="field-note">Ready for editorial handoff</span>';
-  if (status === 'failed' && job?.id) return `<button class="quiet" type="button" data-retry-job="${esc(job.id)}">Retry</button>`;
+  if (status === 'failed' && job?.id) return `${researchAction}<button class="quiet" type="button" data-retry-job="${esc(job.id)}">Retry</button>`;
   if (href) return `<a class="button quiet" href="${href}">Open story</a>`;
   return '<span class="field-note">Open assignment</span>';
 }
