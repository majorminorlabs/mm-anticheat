@@ -0,0 +1,43 @@
+{
+  "blind_results_seen": false,
+  "hard_cases": {
+    "p06_l6_imagery_incomplete": "L12 has a physically coherent riverbed sequence but drifts into process explanation; no decisive imagery/cadence gain over L6.",
+    "p07_forbidden_concept": "No prohibited jealous stem, but a direct synonym names the feeling; fails the indirectness request.",
+    "p16_premature_stopping": "Emergency-exit moth response ends on an unfinished final word.",
+    "p18_inland_lighthouse": "Correctly negates nearby ocean/harbor, a gain over L6; relies on conventional lighthouse/sentinel rhyme and trails into a fragment.",
+    "p19_silent_car": "A driver statement breaks the silent argument relation, despite quieter lineation than the 4B base.",
+    "p33_b0_or_l1_preference": "L12 clock collector is coherent conventional narrative; L1 has a riskier clock/body association, while B0 is another ordinary story. No obvious L12 creative win.",
+    "p39_through_wall": "Opening largely restates the prompt; later names and voices do not sustain a clear through-wall source.",
+    "p50_late_voicemail_refrain": "Phone and boat details appear, but no clear late voicemail or repeated refrain."
+  },
+  "notes": {
+    "p01": "A coherent return-home story, but narrative prose explains the prompt and adds a conventional disaster plot.",
+    "p02": "Enclosed room/light relation is present; three ordinary prose paragraphs and a cut-off last clause.",
+    "p04": "Rain remains outside the hospital, and a named doctor turns the request into conventional narrative prose.",
+    "p06": "Sustained physical account of glass in moving water, but much of it reads as explanatory process description rather than distinctive lyric.",
+    "p07": "Social comparison is present but the emotion is named by synonym; generic bedroom prose and incomplete ending.",
+    "p10": "Concrete staircase and theater details, then internally inconsistent empty-theater occupancy and prose narration.",
+    "p12": "Moves into self-help language and a malformed all-caps sentence; weak suspicious-relief concept.",
+    "p16": "Emergency-exit moth has line breaks, but generic imagery and stops mid-line.",
+    "p18": "Lighthouse is placed away from water; formulaic sentinel/rhyme language and an unfinished final fragment.",
+    "p29": "Sustained dread-before-celebration scene but mostly literal narrative paragraphs with stock tension cues.",
+    "p33": "Broken-clock collector remains on topic yet explains the collection in ordinary prose; weaker surprise than L1 clock/body turn.",
+    "p38": "Misses the mouth-of-salt subject entirely, substituting generic romantic assurances.",
+    "p42": "A coherent invented backstory, but ordinary explanatory prose and incomplete ending.",
+    "p43": "Recognizable lyric-shaped repeated passage, but generic romance phrases and an incomplete ending.",
+    "p48": "Verse and repeated chorus are present; imagery and phrasing are conventional.",
+    "p50": "Voicemail/refrain request drifts into unrelated boat/phone story without a recognizable refrain."
+  },
+  "reviewed_at_utc": "2026-10-05T00:00:13Z",
+  "scope": "Codex agent direct reading of frozen 16-prompt qualitative subset at selected L12-35; comparisons to saved L1/L6 where noted, not human scoring.",
+  "selected_generation_sha256": "7bcab6df6dc05fb71f3413058346e126d070f0bebfde7caeab493bc03336ed97",
+  "subset_source": "corpus/metadata/l4_qualitative_subset.json",
+  "synthesis": {
+    "cadence_and_form": "Adaptation yields more line breaks than the 4B base, but many lines are wrapped prose or stock rhyme.",
+    "completeness": "Step 35 is much less truncated than step 50, yet multiple reviewed outputs end mid-sentence or mid-line.",
+    "imagery_and_phrasing": "A few concrete details; much conventional sentinel, shadows, and romance phrasing. No clear increase in useful unusual imagery.",
+    "overall": "The direct reading does not establish a materially better specialized writer than L1 or L6; blind judgments remain the primary gate.",
+    "prompt_usability": "Clear failures on hospital rain, salt, voicemail/refrain, and several relational constraints.",
+    "semantic_connections": "More coherent sentences than some 1.7B outputs, but often follows one literal scene without a distant-image connection."
+  }
+}
