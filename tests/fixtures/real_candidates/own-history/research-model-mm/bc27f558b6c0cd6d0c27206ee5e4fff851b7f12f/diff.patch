+def _runtime_report(backend: Any, started_at: str, started_clock: float, examples: int) -> dict[str, Any]:
+    ended_at = datetime.now(timezone.utc).isoformat()
+    elapsed = time.perf_counter() - started_clock
+    report: dict[str, Any] = {
+        "start_time": started_at,
+        "end_time": ended_at,
+        "duration_seconds": round(elapsed, 3),
+        "examples_completed": examples,
+        "examples_per_second": round(examples / elapsed, 4) if elapsed > 0 else None,
+    }
+    torch = getattr(backend, "torch", None)
+    cuda = getattr(torch, "cuda", None)
+    if cuda is not None and cuda.is_available():
+        try:
+            cuda.synchronize()
+            device = cuda.current_device()
+            properties = cuda.get_device_properties(device)
+            try:
+                driver_versions = sorted(set(subprocess.check_output(
+                    ["nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader"],
+                    text=True,
+                    stderr=subprocess.DEVNULL,
+                    timeout=5,
+                ).strip().splitlines()))
+            except (FileNotFoundError, subprocess.SubprocessError):
+                driver_versions = None
+            report["gpu"] = {
+                "name": cuda.get_device_name(device),
+                "visible_count": cuda.device_count(),
+                "total_vram_bytes": properties.total_memory,
+                "driver_versions": driver_versions,
+                "peak_allocated_vram_bytes": cuda.max_memory_allocated(device),
+                "peak_reserved_vram_bytes": cuda.max_memory_reserved(device),
+                "allocated_after_run_bytes": cuda.memory_allocated(device),
+                "reserved_after_run_bytes": cuda.memory_reserved(device),
+                "cuda_version": getattr(getattr(torch, "version", None), "cuda", None),
+                "torch_version": getattr(torch, "__version__", None),
+            }
+        except (AttributeError, RuntimeError):
+            report["gpu"] = {"measurement_error": "CUDA memory telemetry unavailable"}
+    else:
+        report["gpu"] = {"available": False, "note": "No CUDA device attached to this backend."}
+    return report
