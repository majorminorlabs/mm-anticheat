+  text-decoration: underline;
+  text-underline-offset: 3px;
+  cursor: pointer;
+}
+
+.concierge-question {
+  display: grid;
+  gap: 7px;
+  padding-top: 16px;
+  border-top: 1px solid var(--hairline);
+}
+
+.concierge-question label {
+  font-size: 13px;
+  font-weight: 700;
+}
+
+.concierge-question__controls {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 46px;
+}
+
+.concierge-question input {
+  min-width: 0;
+  min-height: 46px;
+  border: 1px solid var(--hairline);
+  border-right: 0;
+  border-radius: var(--radius) 0 0 var(--radius);
+  padding: 10px 12px;
+  background: #fff;
+  color: var(--ink-navy);
+  font-size: 14px;
+}
+
+.concierge-question input::placeholder {
+  color: var(--driftwood);
+  opacity: 0.85;
+}
+
+.concierge-question__controls button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 46px;
+  min-height: 46px;
+  border: 1px solid var(--brass-dark);
+  border-radius: 0 var(--radius) var(--radius) 0;
+  padding: 0;
+  background: var(--brass);
+  color: var(--on-brass);
+  cursor: pointer;
+}
+
+.concierge-question > p {
+  color: var(--driftwood);
+  font-size: 11px;
+  line-height: 1.4;
+}
+
+.concierge-footer {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+  padding: 12px 18px calc(12px + env(safe-area-inset-bottom, 0px));
+  border-top: 1px solid var(--hairline);
+  background: var(--bay-fog);
+}
+
+.concierge-action {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 46px;
+  gap: 7px;
+  border: 1px solid var(--ink-navy);
+  border-radius: var(--radius);
+  padding: 10px 11px;
+  background: transparent;
+  color: var(--ink-navy);
+  font-size: 12px;
+  font-weight: 700;
+  line-height: 1.2;
+  text-align: center;
+  cursor: pointer;
+}
+
+.concierge-action--primary,
+.concierge-action--prominent {
+  border-color: var(--brass-dark);
+  background: var(--brass);
+  color: var(--on-brass);
+}
+
+.concierge-action--emergency {
+  border-color: var(--brick);
+  color: var(--brick);
+}
+
+.concierge-action:hover {
+  border-color: var(--brass-text);
+}
+
+@keyframes concierge-enter {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@media (max-width: 640px) {
+  .concierge-launcher {
+    right: calc(12px + env(safe-area-inset-right, 0px));
+    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
+    min-height: 48px;
+    padding: 10px 13px;
+  }
+
+  body:has(.lead-form:focus-within) .concierge-launcher {
+    opacity: 0;
+    pointer-events: none;
+    transform: translateY(12px);
+    visibility: hidden;
+  }
+
+  .concierge-dialog {
+    inset: auto 0 0;
+    width: 100%;
+    height: min(760px, calc(100dvh - 12px - env(safe-area-inset-top, 0px)));
+    max-height: calc(100dvh - 12px - env(safe-area-inset-top, 0px));
+    border-right: 0;
+    border-bottom: 0;
+    border-left: 0;
+  }
+
+  .concierge-dialog[open] {
+    animation-name: concierge-sheet-enter;
+  }
+
+  .concierge-header {
+    padding: 14px 16px 12px;
+  }
+
+  .concierge-heading h2 {
+    font-size: 22px;
+  }
+
+  .concierge-body {
+    gap: 16px;
+    padding: 16px;
+    scrollbar-gutter: auto;
+  }
+
+  .concierge-footer {
+    padding-right: 16px;
+    padding-left: 16px;
+  }
+}
+
+@media (max-width: 380px) {
+  .concierge-launcher span {
+    display: none;
+  }
+
+  .concierge-launcher {
+    width: 48px;
+    padding: 0;
+  }
+
+  .concierge-choices,
+  .concierge-footer {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-height: 520px) {
+  .concierge-dialog {
+    inset: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) 0
+      env(safe-area-inset-left, 0px);
+    width: auto;
+    height: auto;
+    max-height: none;
+    border: 0;
+  }
+}
+
+@keyframes concierge-sheet-enter {
+  from {
+    opacity: 0;
+    transform: translateY(20px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
