diff --git a/solution.py b/solution.py
index da85e31..f112b87 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,39 @@ def can_tile_grid(n: int, h: int, w: int, tiles: List[Tuple[int, int]]) -> bool:
     >>> can_tile_grid(1, 2, 2, [(1, 1)])
     False
     """
-    raise NotImplementedError
+    tiles = tiles[:n]
+    grid = [[False] * w for _ in range(h)]
+    used = [False] * n
+
+    def fits(r: int, c: int, a: int, b: int) -> bool:
+        if r + a > h or c + b > w:
+            return False
+        return not any(grid[i][j] for i in range(r, r + a) for j in range(c, c + b))
+
+    def fill(r: int, c: int, a: int, b: int, value: bool) -> None:
+        for i in range(r, r + a):
+            for j in range(c, c + b):
+                grid[i][j] = value
+
+    def dfs(pos: int) -> bool:
+        # Advance to the first uncovered cell in row-major order
+        while pos < h * w and grid[pos // w][pos % w]:
+            pos += 1
+        if pos == h * w:
+            return True
+        r, c = divmod(pos, w)
+        for i in range(n):
+            if used[i]:
+                continue
+            a, b = tiles[i]
+            for x, y in {(a, b), (b, a)}:
+                if fits(r, c, x, y):
+                    used[i] = True
+                    fill(r, c, x, y, True)
+                    if dfs(pos):
+                        return True
+                    fill(r, c, x, y, False)
+                    used[i] = False
+        return False
+
+    return dfs(0)
