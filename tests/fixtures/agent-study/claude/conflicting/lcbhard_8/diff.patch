diff --git a/solution.py b/solution.py
index 1f12da2..8739192 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,32 @@ def kth_smallest_amount(coins: List[int], k: int) -> int:
     >>> kth_smallest_amount([5, 2], 7)
     12
     """
-    raise NotImplementedError
+    from math import gcd
+
+    n = len(coins)
+    hi = min(coins) * k
+    # Precompute signed lcm for each non-empty subset (inclusion-exclusion).
+    terms = []
+    lcms = [1] * (1 << n)
+    bits = [0] * (1 << n)
+    for mask in range(1, 1 << n):
+        low = mask & -mask
+        i = low.bit_length() - 1
+        prev = mask ^ low
+        a = lcms[prev]
+        lcms[mask] = a * coins[i] // gcd(a, coins[i])
+        bits[mask] = bits[prev] + 1
+        if lcms[mask] <= hi:
+            terms.append((lcms[mask], 1 if bits[mask] & 1 else -1))
+
+    def count(x: int) -> int:
+        return sum(sign * (x // l) for l, sign in terms)
+
+    lo = 1
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if count(mid) >= k:
+            hi = mid
+        else:
+            lo = mid + 1
+    return lo
