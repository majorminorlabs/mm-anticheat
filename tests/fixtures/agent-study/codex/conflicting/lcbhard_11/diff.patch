-    raise NotImplementedError
+    modulus = 998244353
+    inverse_n = pow(N, -1, modulus)
+    # From position x, each other position is reached with probability 2/N^2.
+    # Thus E_next = (1 - 2/N) * E + (N + 1)/N, whose fixed point is
+    # (N + 1)/2. The initial deviation from that fixed point is (1 - N)/2.
+    decay = pow((1 - 2 * inverse_n) % modulus, K, modulus)
