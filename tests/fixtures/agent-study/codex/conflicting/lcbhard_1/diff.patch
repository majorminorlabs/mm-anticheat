--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,35 @@ def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:
     >>> count_powerful_integers(1000, 2000, 4, "3000")
     0
     """
-    raise NotImplementedError
+    if start > finish or any(int(digit) > limit for digit in s):
+        return 0
+
+    suffix = int(s)
+    scale = 10 ** len(s)
+
+    def count_up_to(bound: int) -> int:
+        # Every candidate is prefix * scale + suffix. Count admissible
+        # prefixes without enumerating the (potentially enormous) range.
+        maximum_prefix = (bound - suffix) // scale
+        if maximum_prefix < 0:
+            return 0
+
+        digits = str(maximum_prefix)
+        count = 0
+        choices = limit + 1
+        for index, character in enumerate(digits):
+            digit = int(character)
+            remaining = len(digits) - index - 1
+            count += min(digit, choices) * choices ** remaining
+            if digit > limit:
+                break
+        else:
+            count += 1  # The bound itself also has admissible digits.
+
+        # Prefix zero is valid only when s is itself a positive integer's
+        # complete decimal representation (without leading zeros).
+        if suffix == 0 or s[0] == "0":
+            count -= 1
+        return count
+
+    return count_up_to(finish) - count_up_to(start - 1)
