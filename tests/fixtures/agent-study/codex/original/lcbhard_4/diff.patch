@@ -1,4 +1,5 @@
 from typing import Optional, List
+from itertools import permutations
 
 
 def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
@@ -21,7 +22,51 @@ def solve_grid(n: int, r: str, c: str) -> Optional[List[str]]:
     
     >>> solve_grid(3, 'ABC', 'ABC')
     ['ABC', 'BCA', 'CAB']
-    >>> solve_grid(3, 'AAA', 'BBB')
-    None
+    >>> solve_grid(3, 'AAA', 'BBB') is None
+    True
     """
-    raise NotImplementedError
+    # Every candidate row has all three letters, with the required first one.
+    candidates = {letter: [] for letter in 'ABC'}
+    for positions in permutations(range(n), 3):
+        row = ['.'] * n
+        for letter, column in zip('ABC', positions):
+            row[column] = letter
+        first = row[min(positions)]
+        candidates[first].append(''.join(row))
+
+    column_masks = [0] * n
+    grid = []
+
+    def search(row_index: int) -> bool:
+        if row_index == n:
+            return all(mask == 7 for mask in column_masks)
+
+        for row in candidates[r[row_index]]:
+            placements = []
+            for column, letter in enumerate(row):
+                if letter == '.':
+                    continue
+                bit = 1 << (ord(letter) - ord('A'))
+                if column_masks[column] & bit:
+                    break
+                if column_masks[column] == 0 and letter != c[column]:
+                    break
+                placements.append((column, bit))
+            else:
+                for column, bit in placements:
+                    column_masks[column] |= bit
+                grid.append(row)
+
+                remaining_rows = n - row_index - 1
+                if (all(3 - mask.bit_count() <= remaining_rows
+                        for mask in column_masks)
+                        and search(row_index + 1)):
+                    return True
+
+                grid.pop()
+                for column, bit in placements:
+                    column_masks[column] ^= bit
+
+        return False
+
+    return grid if search(0) else None
