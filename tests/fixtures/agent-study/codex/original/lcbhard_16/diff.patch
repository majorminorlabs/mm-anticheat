@@ -19,4 +19,95 @@ def count_good_sequences(N: int, M: int) -> int:
     >>> count_good_sequences(370, 907)
     221764640
     """
-    raise NotImplementedError
+    from math import isqrt
+
+    mod = 998244353
+    if N < 2:
+        return 0
+
+    limit = isqrt(N)
+    sieve = bytearray(b'\x01') * (limit + 1)
+    sieve[:2] = b'\x00\x00'
+    for p in range(2, isqrt(limit) + 1):
+        if sieve[p]:
+            sieve[p * p::p] = b'\x00' * ((limit - p * p) // p + 1)
+    primes = [p for p in range(2, limit + 1) if sieve[p]]
+
+    # Count primes congruent to 1 and 2 modulo 3 at every floor(N / i).
+    # Multiples of 3 are omitted from the outset; prime 3 is added later.
+    small1 = [(x - 1) // 3 for x in range(limit + 1)]
+    small2 = [(x + 1) // 3 for x in range(limit + 1)]
+    small1[0] = 0
+    large1 = [0] + [(N // i - 1) // 3 for i in range(1, limit + 1)]
+    large2 = [0] + [(N // i + 1) // 3 for i in range(1, limit + 1)]
+    seen1 = seen2 = 0
+    for p in primes:
+        residue = p % 3
+        if not residue:
+            continue
+        end = min(limit, N // (p * p))
+        split = min(end, limit // p)
+        if residue == 1:
+            for i in range(1, split + 1):
+                large1[i] -= large1[i * p] - seen1
+                large2[i] -= large2[i * p] - seen2
+            for i in range(split + 1, end + 1):
+                y = N // (i * p)
+                large1[i] -= small1[y] - seen1
+                large2[i] -= small2[y] - seen2
+            for x in range(limit, p * p - 1, -1):
+                small1[x] -= small1[x // p] - seen1
+                small2[x] -= small2[x // p] - seen2
+            seen1 += 1
+        else:
+            for i in range(1, split + 1):
+                large1[i] -= large2[i * p] - seen2
+                large2[i] -= large1[i * p] - seen1
+            for i in range(split + 1, end + 1):
+                y = N // (i * p)
+                large1[i] -= small2[y] - seen2
+                large2[i] -= small1[y] - seen1
+            for x in range(limit, p * p - 1, -1):
+                small1[x] -= small2[x // p] - seen2
+                small2[x] -= small1[x // p] - seen1
+            seen2 += 1
+
+    # A prime exponent e can be distributed among M ordered factors in
+    # C(M + e - 1, e) ways.
+    weights = [1]
+    for e in range(1, N.bit_length()):
+        weights.append(weights[-1] * (M + e - 1) * pow(e, mod - 2, mod) % mod)
+    allowed_prefix = [0]
+    for p in primes:
+        allowed_prefix.append(allowed_prefix[-1] + (p % 3 != 2))
+
+    def sums(x, start):
+        """Total and non-good weights with all prime factors >= primes[start]."""
+        if x <= limit:
+            c1, c2 = small1[x], small2[x]
+        else:
+            i = N // x
+            c1, c2 = large1[i], large2[i]
+        total = M * (c1 + c2 + (x >= 3) - start)
+        bad = M * (c1 + (x >= 3) - allowed_prefix[start])
+        for j in range(start, len(primes)):
+            p = primes[j]
+            if p * p > x:
+                break
+            power = p
+            e = 1
+            residue = p % 3
+            while power * p <= x:
+                sub_total, sub_bad = sums(x // power, j + 1)
+                total += weights[e] * sub_total + weights[e + 1]
+                # sigma(p^e) is nonzero mod 3 precisely for these exponents.
+                if residue == 0 or (residue == 1 and e % 3 != 2) or (residue == 2 and e % 2 == 0):
+                    bad += weights[e] * sub_bad
+                if residue == 0 or (residue == 1 and (e + 1) % 3 != 2) or (residue == 2 and (e + 1) % 2 == 0):
+                    bad += weights[e + 1]
+                power *= p
+                e += 1
+        return total % mod, bad % mod
+
+    total, bad = sums(N, 0)
+    return (total - bad) % mod
