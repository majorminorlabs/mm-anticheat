@@ -20,4 +23,20 @@ def count_ways_to_stair(k: int) -> int:
     >>> count_ways_to_stair(512)
     1
     """
-    raise NotImplementedError
+    ways = 0
+    jumps = 0
+    stair = 1
+
+    # After j upward jumps, Alice is at 2**j minus the number of
